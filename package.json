{
  "name": "targetj",
  "version": "1.0.260",
  "description": "TargetJS: JavaScript UI framework where state includes the journey and code order defines the UI sequence",
  "keywords": [
    "targetjs",
    "javascript",
    "ui",
    "framework",
    "frontend",
    "reactive",
    "animation",
    "state-management",
    "web-framework"
  ],
  "type": "module",
  "main": "./Export.js",
  "module": "./Export.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./Export.js",
      "default": "./Export.js"
    }
  },
  "homepage": "https://targetjs.io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livetrails/targetjs.git"
  },
  "bugs": {
    "url": "https://github.com/livetrails/targetjs/issues"
  },
  "contributors": [
    {
      "name": "Ahmad Wasfi"
    }
  ],
  "scripts": {
    "prod": "webpack --config webpack.config.cjs --mode production && gzip -kf ./dist/targetjs.js",
    "dev": "webpack --config webpack.config.cjs --mode development",
    "build": "babel src --out-dir build",
    "test:types": "tsc --noEmit --strict --lib ES2022,DOM types/index.d.ts",
    "prepack": "npm run build && npm run prod && npm run test:types"
  },
  "files": [
    "types",
    "Export.js",
    "build/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@babel/cli": "^7.25.6",
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.0",
    "@babel/preset-env": "^7.25.4",
    "babel-loader": "^9.1.0",
    "eslint-webpack-plugin": "^4.2.0",
    "typescript": "^7.0.2",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
